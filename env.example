# Copy this file to backend/.env and fill in your own values.
# Never commit the real .env file — it's already in .gitignore.

# Secret used to sign agent identity JWTs. Use a long random string in production.
PAYPILOT_JWT_SECRET=change-me-to-a-long-random-string

# Port the backend listens on (optional, defaults to 4000)
PORT=4000
